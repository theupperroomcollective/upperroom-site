# Copy to .env for local overrides. Real values are set in Vercel.
SITE_URL=https://example.com
PUBLIC_FATHOM_SITE_ID=
BLOCK_INDEXING=true
# Google Apps Script web app URL that writes form submissions to the Google Sheet.
# See integrations/google-sheets/README.md. Leave empty and forms say "not connected yet".
PUBLIC_SHEETS_ENDPOINT=
