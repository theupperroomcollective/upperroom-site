---
/**
 * SiteHeader — logo, main navigation and the mobile menu.
 * Links come from src/content/site.yaml. A nav item is either a link
 * ({ label, href }) or a group ({ label, children: [links] }), which renders
 * as a dropdown on desktop and a labeled group in the mobile menu.
 *
 * Desktop dropdowns use the disclosure pattern (button + aria-expanded):
 * click or Enter/Space to open, Escape or clicking outside to close.
 * The mobile menu is a native <dialog> (focus trap, Escape, backdrop for free).
 */
import { getEntry } from "astro:content";
import Logo from "../assets/brand/logo.svg";
import Button from "./Button.astro";

const site = (await getEntry("site", "main"))!.data;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => path === href || (href !== "/" && path.startsWith(`${href}/`));
const groupIsCurrent = (children: { href: string }[]) => children.some((c) => isCurrent(c.href));
const slug = (label: string) => label.toLowerCase().replace(/[^a-z0-9]+/g, "-");
---

<header class="header" data-surface="ivory">
  <div class="container header__inner">
    <a class="header__logo" href="/" aria-label={`${site.name}, home`}>
      <Logo aria-hidden="true" focusable="false" />
    </a>

    <nav class="header__nav" aria-label="Main">
      <ul class="header__list">
        {
          site.nav.map((item) =>
            "children" in item ? (
              <li class="dropdown" data-dropdown>
                <button
                  class:list={["dropdown__toggle", { "is-current": groupIsCurrent(item.children) }]}
                  type="button"
                  aria-expanded="false"
                  aria-controls={`nav-${slug(item.label)}`}
                >
                  {item.label}
                  <svg viewBox="0 0 12 8" aria-hidden="true" focusable="false">
                    <path d="M1 1.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.3" />
                  </svg>
                </button>
                <ul class="dropdown__panel" id={`nav-${slug(item.label)}`} hidden>
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} aria-current={isCurrent(child.href) ? "page" : undefined}>
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
      <Button href={site.navCta.href} arrow={false}>{site.navCta.label}</Button>
    </nav>

    <button class="header__menu-button" type="button" aria-haspopup="dialog" aria-controls="mobile-menu" data-menu-open>
      <span class="visually-hidden">Open menu</span>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M3 7h18M3 12h18M3 17h18" fill="none" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </button>
  </div>

  <dialog id="mobile-menu" class="menu" data-surface="wine" aria-label="Menu">
    <div class="menu__top">
      <a class="header__logo" href="/" aria-label={`${site.name}, home`}>
        <Logo aria-hidden="true" focusable="false" />
      </a>
      <button class="menu__close" type="button" data-menu-close autofocus>
        <span class="visually-hidden">Close menu</span>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M5 5l14 14M19 5L5 19" fill="none" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </button>
    </div>
    <nav aria-label="Mobile">
      <ul class="menu__list">
        <li><a href="/" aria-current={path === "/" ? "page" : undefined}>Home</a></li>
        {
          site.nav.map((item) =>
            "children" in item ? (
              <li class="menu__group">
                <p class="menu__group-label" id={`menu-${slug(item.label)}`}>
                  {item.label}
                </p>
                <ul aria-labelledby={`menu-${slug(item.label)}`}>
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} aria-current={isCurrent(child.href) ? "page" : undefined}>
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>
    <Button href={site.navCta.href}>{site.navCta.label}</Button>
  </dialog>
</header>

<script>
  // ---- Mobile menu ----
  const dialog = document.querySelector<HTMLDialogElement>("#mobile-menu");
  document.querySelector("[data-menu-open]")?.addEventListener("click", () => dialog?.showModal());
  document.querySelector("[data-menu-close]")?.addEventListener("click", () => dialog?.close());
  dialog?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => dialog.close()));
  window.matchMedia("(min-width: 64em)").addEventListener("change", (e) => {
    if (e.matches) dialog?.close();
  });

  // ---- Desktop dropdowns ----
  const dropdowns = [...document.querySelectorAll<HTMLElement>("[data-dropdown]")];

  function setOpen(dropdown: HTMLElement, open: boolean) {
    const toggle = dropdown.querySelector<HTMLButtonElement>(".dropdown__toggle");
    const panel = dropdown.querySelector<HTMLElement>(".dropdown__panel");
    if (!toggle || !panel) return;
    toggle.setAttribute("aria-expanded", String(open));
    panel.hidden = !open;
  }

  dropdowns.forEach((dropdown) => {
    const toggle = dropdown.querySelector<HTMLButtonElement>(".dropdown__toggle");
    toggle?.addEventListener("click", () => {
      const willOpen = toggle.getAttribute("aria-expanded") !== "true";
      dropdowns.forEach((d) => setOpen(d, false));
      setOpen(dropdown, willOpen);
    });
    dropdown.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
        setOpen(dropdown, false);
        toggle.focus();
      }
    });
    dropdown.addEventListener("focusout", (event) => {
      if (!dropdown.contains(event.relatedTarget as Node | null)) setOpen(dropdown, false);
    });
  });

  document.addEventListener("click", (event) => {
    dropdowns.forEach((d) => {
      if (!d.contains(event.target as Node)) setOpen(d, false);
    });
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    border-bottom: var(--border-width) solid var(--border);
    background-color: color-mix(in oklab, var(--surface), transparent 6%);
    backdrop-filter: blur(8px);
  }

  .header__inner {
    display: flex;
    gap: var(--space-lg);
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-height);
  }

  .header__logo {
    display: block;
    flex-shrink: 0;
    color: var(--text-heading);
  }

  .header__logo :global(svg) {
    width: auto;
    height: 2.25rem;
  }

  .header__nav {
    display: none;
    gap: var(--space-lg);
    align-items: center;
  }

  .header__list {
    display: flex;
    gap: var(--space-md);
    align-items: center;
    padding: 0;
    list-style: none;
  }

  .header__list a,
  .dropdown__toggle {
    color: var(--text-strong);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .header__list > li > a:hover,
  .header__list a[aria-current="page"],
  .dropdown__toggle:hover,
  .dropdown__toggle.is-current {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.35em;
  }

  /* ---- Dropdown ---- */
  .dropdown {
    position: relative;
  }

  .dropdown__toggle {
    display: inline-flex;
    gap: var(--space-2xs);
    align-items: center;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .dropdown__toggle svg {
    width: 0.625rem;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .dropdown__toggle[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }

  .dropdown__panel {
    position: absolute;
    top: calc(100% + var(--space-sm));
    left: calc(var(--space-md) * -1);
    min-width: 15rem;
    padding: var(--space-2xs);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-md);
    background-color: var(--surface-raised);
    box-shadow: var(--shadow-card);
    list-style: none;
  }

  .dropdown__panel a {
    display: block;
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
  }

  .dropdown__panel a:hover,
  .dropdown__panel a[aria-current="page"] {
    background-color: var(--surface-sunken);
    text-decoration: none;
  }

  /* ---- Menu buttons ---- */
  .header__menu-button,
  .menu__close {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-strong);
    cursor: pointer;
  }

  .header__menu-button svg,
  .menu__close svg {
    width: 1.5rem;
  }

  @media (width >= 64em) {
    .header__nav {
      display: flex;
    }

    .header__menu-button {
      display: none;
    }
  }

  /* ---- Mobile menu ---- */
  .menu {
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    padding: var(--space-sm) var(--gutter) var(--space-xl);
    border: 0;
    color: var(--text-heading);
  }

  .menu[open] {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    overflow-y: auto;
  }

  .menu::backdrop {
    background-color: var(--surface);
  }

  .menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: calc(var(--header-height) - var(--space-sm));
  }

  .menu__close {
    color: var(--text-heading);
  }

  .menu__list,
  .menu__group ul {
    display: grid;
    gap: var(--space-xs);
    padding: 0;
    list-style: none;
  }

  .menu__list a {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    text-decoration: none;
  }

  .menu__list a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-thickness: var(--border-width);
  }

  .menu__group {
    display: grid;
    gap: var(--space-2xs);
    padding-block: var(--space-xs);
    border-block: var(--border-width) solid var(--border);
  }

  .menu__group-label {
    color: var(--text-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .menu__group a {
    font-size: var(--text-xl);
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu[open] {
      animation: menu-in var(--duration-base) var(--ease-out);
    }

    @keyframes menu-in {
      from {
        opacity: 0;
        transform: translateY(-8px);
      }
    }
  }
</style>
