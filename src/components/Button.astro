---
/**
 * Button — the only way to render a call to action.
 * variant: "primary" (filled), "secondary" (outlined), "text" (underlined link with arrow).
 * Colors come from the surrounding data-surface, so it works on ivory, wine and stone.
 */
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "text";
  arrow?: boolean;
}

const { href, variant = "primary", arrow = true } = Astro.props;
---

<a class:list={["button", `button--${variant}`]} href={href}>
  <span><slot /></span>
  {
    arrow && (
      <svg class="button__arrow" viewBox="0 0 16 10" aria-hidden="true" focusable="false">
        <path d="M0 5h14M10 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" />
      </svg>
    )
  }
</a>

<style>
  .button {
    display: inline-flex;
    gap: var(--space-xs);
    align-items: center;
    min-height: 2.875rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: 0.02em;
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .button__arrow {
    width: 1rem;
    flex-shrink: 0;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .button:hover .button__arrow {
    transform: translateX(3px);
  }

  .button--primary,
  .button--secondary {
    padding: var(--space-xs) var(--space-md);
    border: var(--border-width) solid var(--accent);
    border-radius: var(--radius-sm);
  }

  .button--primary {
    background-color: var(--accent);
    color: var(--on-accent);
  }

  .button--primary:hover {
    background-color: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  .button--secondary {
    background-color: transparent;
    color: var(--accent);
  }

  .button--secondary:hover {
    background-color: var(--accent);
    color: var(--on-accent);
  }

  .button--text {
    min-height: 2.75rem;
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 0.35em;
  }

  .button--text:hover {
    text-decoration-color: currentcolor;
  }
</style>
