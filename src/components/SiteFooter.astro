---
/** SiteFooter — newsletter, link groups and contact. Content from src/content/site.yaml. */
import { getEntry } from "astro:content";
import Logo from "../assets/brand/logo.svg";
import NewsletterForm from "./NewsletterForm.astro";

const site = (await getEntry("site", "main"))!.data;
const year = new Date().getFullYear();
---

<footer class="footer" data-surface="stone">
  <div class="container">
    <div class="footer__top">
      <div class="footer__intro">
        <p class="footer__scripture">
          {site.footerScripture.text} <span>{site.footerScripture.reference}</span>
        </p>
        <h2 class="footer__heading">Stay in the Room.</h2>
        <p>Get the latest updates, founder experiences and opportunities from {site.name}.</p>
        <NewsletterForm id="footer-newsletter" />
      </div>

      <div class="footer__groups">
        {
          site.footerGroups.map((group) => (
            <nav aria-label={group.heading}>
              <h2 class="footer__group-heading">{group.heading}</h2>
              <ul>
                {group.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>

    <div class="footer__bottom">
      <a class="footer__logo" href="/" aria-label={`${site.name}, home`}>
        <Logo aria-hidden="true" focusable="false" />
      </a>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <p>© {year} {site.name}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-2xl) var(--space-lg);
    font-size: var(--text-sm);
  }

  .footer__top {
    display: grid;
    gap: var(--space-2xl);
    padding-bottom: var(--space-2xl);
    border-bottom: var(--border-width) solid var(--border);
  }

  @media (width >= 56em) {
    .footer__top {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .footer__intro {
    display: grid;
    gap: var(--space-sm);
    max-width: 32rem;
  }

  .footer__scripture {
    color: var(--text-heading);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-style: italic;
  }

  .footer__scripture span {
    margin-left: var(--space-2xs);
    color: var(--text-body);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-style: normal;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .footer__heading {
    font-size: var(--text-2xl);
  }

  .footer__groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-lg);
  }

  .footer__group-heading {
    margin-bottom: var(--space-sm);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .footer__groups ul {
    display: grid;
    gap: var(--space-2xs);
    padding: 0;
    list-style: none;
  }

  .footer__groups a,
  .footer__bottom a {
    text-decoration: none;
  }

  .footer__groups a:hover,
  .footer__bottom a:hover {
    color: var(--text-heading);
    text-decoration: underline;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-lg);
  }

  .footer__logo {
    color: var(--text-heading);
  }

  .footer__logo :global(svg) {
    width: auto;
    height: 2rem;
  }
</style>
