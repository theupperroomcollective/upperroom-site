---
/** Eyebrow — small uppercase label above a heading. Optional rule line before it. */
interface Props {
  ruled?: boolean;
}
const { ruled = false } = Astro.props;
---

<p class:list={["eyebrow", { "eyebrow--ruled": ruled }]}><slot /></p>

<style>
  .eyebrow {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
    color: var(--accent);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .eyebrow--ruled::before {
    width: 2.5rem;
    height: var(--border-width);
    background-color: currentcolor;
    content: "";
  }
</style>
