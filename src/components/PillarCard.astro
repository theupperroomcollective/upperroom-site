---
/**
 * PillarCard — one of the five pillars.
 * With an href, the whole card is one link. Without one (e.g. "Coming soon"
 * pillars that have no page yet), it renders as a plain, non-clickable card.
 */
import type { CollectionEntry } from "astro:content";
import Media from "./Media.astro";

interface Props {
  pillar: CollectionEntry<"pillars">["data"];
  headingLevel?: "h2" | "h3";
}

const { pillar, headingLevel: Heading = "h3" } = Astro.props;
const number = String(pillar.order).padStart(2, "0");
const Tag = pillar.href ? "a" : "article";
---

<Tag class:list={["pillar", { "pillar--link": pillar.href }]} href={pillar.href}>
  <Media {...pillar.image} ratio="landscape" rounded={false} />
  {pillar.status && <span class="pillar__status">{pillar.status}</span>}
  <div class="pillar__body">
    <p class="pillar__number">{number} · {pillar.verb}</p>
    <Heading class="pillar__title">{pillar.title}</Heading>
    <p class="pillar__summary">{pillar.summary}</p>
    {
      pillar.href && pillar.cta && (
        <span class="pillar__cta" aria-hidden="true">
          {pillar.cta}
          <svg viewBox="0 0 16 10" focusable="false">
            <path d="M0 5h14M10 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" />
          </svg>
        </span>
      )
    }
  </div>
</Tag>

<style>
  .pillar {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-md);
    background-color: var(--surface-raised);
    text-decoration: none;
    transition:
      border-color var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .pillar--link:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-card);
    transform: translateY(-2px);
  }

  .pillar__status {
    position: absolute;
    top: var(--space-sm);
    left: var(--space-sm);
    padding: var(--space-3xs) var(--space-xs);
    border-radius: var(--radius-pill);
    background-color: var(--accent);
    color: var(--on-accent);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
  }

  .pillar__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-md) var(--space-md) var(--space-lg);
  }

  .pillar__number {
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .pillar__summary {
    flex: 1;
    font-size: var(--text-sm);
  }

  .pillar__cta {
    display: inline-flex;
    gap: var(--space-2xs);
    align-items: center;
    margin-top: var(--space-xs);
    color: var(--accent);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .pillar__cta svg {
    width: 1rem;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .pillar--link:hover .pillar__cta svg {
    transform: translateX(3px);
  }
</style>
