---
/**
 * Interest — a standalone landing page: no header or footer, just the message and
 * the form. Copy and fields live in src/content/interest.yaml.
 */
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import SheetForm from "../components/SheetForm.astro";
import Logo from "../assets/brand/logo.svg";

const page = (await getEntry("interest", "interest"))!.data;
const site = (await getEntry("site", "main"))!.data;
---

<BaseLayout title={page.seo.title} description={page.seo.description} bare>
  <div class="container landing__top">
    <div class="landing__logo" role="img" aria-label={site.name}>
      <Logo aria-hidden="true" focusable="false" />
    </div>
  </div>

  <Section labelledby="interest-heading" width="narrow" spacing="tight" align="center">
    <header class="landing__intro">
      <h1 id="interest-heading">{page.heading}</h1>
      <p class="landing__lede">{page.lede}</p>
    </header>

    <SheetForm
      id="interest-form"
      formName={page.form.name}
      fields={page.form.fields}
      submitLabel={page.form.submitLabel}
      success={page.form.success}
      surface="wine"
    />
  </Section>
</BaseLayout>

<style>
  .landing__top {
    padding-top: var(--space-lg);
  }

  .landing__logo {
    width: clamp(10rem, 8rem + 8vw, 14rem);
    margin-inline: auto;
    color: var(--text-heading);
  }

  .landing__logo :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .landing__intro {
    display: grid;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .landing__lede {
    max-width: 36rem;
    margin-inline: auto;
    font-size: var(--text-md);
  }
</style>
