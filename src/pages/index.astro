---
/**
 * Home page. Copy lives in src/content/home.yaml and src/content/pillars.yaml.
 * Layout is a first pass based on the original site; the final layout is still being designed.
 */
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Button from "../components/Button.astro";
import Media from "../components/Media.astro";
import Scripture from "../components/Scripture.astro";
import PillarCard from "../components/PillarCard.astro";

const home = (await getEntry("home", "home"))!.data;
const pillars = (await getCollection("pillars")).map((p) => p.data).sort((a, b) => a.order - b.order);
---

<BaseLayout title={home.seo.title} description={home.seo.description}>
  <!-- Hero -->
  <Section labelledby="hero-heading" spacing="tight" class="hero">
    <div class="hero__grid">
      <div class="hero__copy flow">
        <h1 id="hero-heading">{home.hero.heading}</h1>
        <p class="hero__kicker">{home.hero.kicker}</p>
        <p class="hero__lede">{home.hero.lede}</p>
        <div class="actions">
          <Button href={home.hero.primary.href}>{home.hero.primary.label}</Button>
          <Button href={home.hero.secondary.href} variant="text">{home.hero.secondary.label}</Button>
        </div>
      </div>
      <Media {...home.hero.image} priority />
    </div>
    <div class="hero__scripture">
      <Scripture {...home.hero.scripture} />
    </div>
  </Section>

  <!-- Who we're for -->
  <Section surface="ivory-deep" labelledby="audience-heading">
    <div class="split">
      <div class="flow">
        <Eyebrow>{home.audience.eyebrow}</Eyebrow>
        <h2 id="audience-heading" class="h-medium">{home.audience.heading}</h2>
      </div>
      <div class="flow">
        <p class="lede">{home.audience.lede}</p>
        <ul class="ticks">
          {home.audience.points.map((point) => <li>{point}</li>)}
        </ul>
        <Button href={home.audience.link.href} variant="text">{home.audience.link.label}</Button>
      </div>
    </div>
  </Section>

  <!-- Mandate -->
  <Section labelledby="mandate-heading" align="center">
    <div class="flow center">
      <Eyebrow>{home.mandate.eyebrow}</Eyebrow>
      <h2 id="mandate-heading" class="mandate__words">
        {home.mandate.words.map((word) => <span>{word}</span>)}
      </h2>
      <hr class="rule" />
      <div class="purpose">
        {home.mandate.purpose.map((line) => <p>{line}</p>)}
      </div>
    </div>
  </Section>

  <!-- Ecosystem intro -->
  <Section surface="wine" width="narrow" align="center" labelledby="ecosystem-heading">
    <div class="flow center">
      <Eyebrow>{home.ecosystem.eyebrow}</Eyebrow>
      <h2 id="ecosystem-heading">{home.ecosystem.heading}</h2>
      <p class="strap">{home.ecosystem.strap}</p>
      <p class="lede">{home.ecosystem.body}</p>
      <hr class="rule" />
      <div class="impact">
        {home.ecosystem.impact.map((line) => <p>{line}</p>)}
      </div>
    </div>
  </Section>

  <!-- Five pillars -->
  <Section label="The five pillars" spacing="tight">
    <ul class="pillars">
      {
        pillars.map((pillar) => (
          <li>
            <PillarCard pillar={pillar} />
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- Founder story -->
  <Section surface="ivory-deep" width="narrow" labelledby="story-heading">
    <div class="flow">
      <Eyebrow ruled>{home.story.eyebrow}</Eyebrow>
      <h2 id="story-heading" class="visually-hidden">A founder's story</h2>
      <Scripture text={home.story.quote} reference={`${home.story.name} · ${home.story.role}`} size="lg" />
      {home.story.link && <Button href={home.story.link.href} variant="text">{home.story.link.label}</Button>}
    </div>
  </Section>

  <!-- Closing -->
  <Section align="center" labelledby="closing-heading" spacing="loose">
    <div class="flow center">
      <h2 id="closing-heading" class="closing__lines">
        {home.closing.lines.map((line) => <span>{line}</span>)}
      </h2>
      <div class="actions actions--center">
        <Button href={home.closing.primary.href}>{home.closing.primary.label}</Button>
        <Button href={home.closing.secondary.href} variant="secondary">{home.closing.secondary.label}</Button>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  /* Hero */
  .hero__grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (width >= 56em) {
    .hero__grid {
      grid-template-columns: 1.05fr 1fr;
      gap: var(--space-2xl);
    }
  }

  .hero__copy {
    --flow-space: var(--space-md);
  }

  .hero__kicker {
    color: var(--text-strong);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .hero__lede,
  .lede {
    font-size: var(--text-lg);
  }

  .hero__scripture {
    max-width: 44rem;
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: var(--border-width) solid var(--border);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
    align-items: center;
  }

  .actions--center {
    justify-content: center;
  }

  /* Split layout */
  .split {
    display: grid;
    gap: var(--space-xl);
  }

  @media (width >= 56em) {
    .split {
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--space-2xl);
    }
  }

  .h-medium {
    font-size: var(--text-2xl);
    line-height: var(--leading-snug);
  }

  .ticks {
    display: grid;
    gap: var(--space-xs);
    padding: 0;
    list-style: none;
  }

  .ticks li {
    position: relative;
    padding-left: var(--space-lg);
  }

  .ticks li::before {
    position: absolute;
    top: 0.7em;
    left: 0;
    width: var(--space-sm);
    height: var(--border-width);
    background-color: var(--accent);
    content: "";
  }

  /* Centered blocks */
  .center {
    display: grid;
    justify-items: center;
  }

  .rule {
    width: 4rem;
    border: 0;
    border-top: var(--border-width) solid var(--border-strong);
  }

  .mandate__words {
    display: grid;
    gap: var(--space-2xs) var(--space-xl);
    font-size: var(--text-3xl);
  }

  @media (width >= 48em) {
    .mandate__words {
      grid-template-columns: repeat(3, auto);
      justify-content: center;
    }
  }

  .purpose,
  .impact {
    display: grid;
    gap: var(--space-3xs);
    color: var(--text-heading);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-style: italic;
  }

  .strap {
    color: var(--text-heading);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  /* Pillars: 1 column on phones, 2 on tablets, 3 + 2 (centered) on desktop */
  .pillars {
    display: grid;
    gap: var(--space-md);
    padding: 0;
    list-style: none;
  }

  @media (width >= 40em) {
    .pillars {
      grid-template-columns: repeat(4, 1fr);
    }

    .pillars > li {
      grid-column: span 2;
    }

    .pillars > li:last-child:nth-child(odd) {
      grid-column: 2 / span 2;
    }
  }

  @media (width >= 64em) {
    .pillars {
      grid-template-columns: repeat(6, 1fr);
    }

    .pillars > li:last-child:nth-child(odd) {
      grid-column: span 2;
    }

    .pillars > li:nth-child(4) {
      grid-column: 2 / span 2;
    }
  }

  /* Closing */
  .closing__lines {
    display: grid;
    font-size: var(--text-3xl);
  }
</style>
