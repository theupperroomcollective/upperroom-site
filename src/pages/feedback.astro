---
// Master class feedback. Content and fields live in src/content/feedback.yaml.
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import SheetForm from "../components/SheetForm.astro";
import Logo from "../assets/brand/logo.svg";

const page = (await getEntry("feedback", "feedback"))!.data;
const site = (await getEntry("site", "main"))!.data;
---

<BaseLayout title={page.seo.title} description={page.seo.description} noindex bare>
  <div class="container landing__top">
    <div class="landing__logo" role="img" aria-label={site.name}>
      <Logo aria-hidden="true" focusable="false" />
    </div>
  </div>

  <Section labelledby="feedback-heading" width="narrow" spacing="tight" align="center">
    <header class="landing__intro">
      <h1 id="feedback-heading">{page.heading}</h1>
      {page.intro.map((paragraph) => <p class="landing__lede">{paragraph}</p>)}
    </header>

    <SheetForm
      id="feedback-form"
      formName={page.form.name}
      fields={page.form.fields}
      submitLabel={page.form.submitLabel}
      success={page.form.success}
      surface="wine"
    />
  </Section>
</BaseLayout>

<style>
  .landing__top {
    padding-top: var(--space-lg);
  }

  .landing__logo {
    width: clamp(10rem, 8rem + 8vw, 14rem);
    margin-inline: auto;
    color: var(--text-heading);
  }

  .landing__logo :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .landing__intro {
    display: grid;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .landing__lede {
    max-width: 36rem;
    margin-inline: auto;
    font-size: var(--text-md);
  }
</style>
